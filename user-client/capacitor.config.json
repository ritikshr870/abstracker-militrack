{
  "appId": "com.abstracker.tracking",
  "appName": "AbsTracker",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "track.abstracker.org",
      "*.abstracker.org",
      "*.openstreetmap.org",
      "*.imagekit.io",
      "*.cartocdn.com"
    ]
  },
  "android": {
    "allowMixedContent": true
  }
}
